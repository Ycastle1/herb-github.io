---
import type { CollectionEntry } from 'astro:content';
import { dateLabel, postPath, readingTime } from '../lib/posts';
interface Props { post: CollectionEntry<'posts'>; index: number; }
const { post, index } = Astro.props;
---
<article class="post-card" data-post data-title={`${post.data.title} ${post.data.description}`.toLocaleLowerCase()} data-tags={JSON.stringify(post.data.tags)}>
  <div class="post-index">{String(index + 1).padStart(2, '0')}</div>
  <div class="post-body">
    <div class="post-meta"><time datetime={post.data.date.toISOString()}>{dateLabel(post.data.date)}</time><span>·</span><span>{readingTime(post)}분 읽기</span></div>
    <h3><a href={postPath(post.id)}>{post.data.title}<span class="post-arrow" aria-hidden="true">↗</span></a></h3>
    <p>{post.data.description}</p>
    <div class="post-tags">{post.data.tags.map(tag => <span>#{tag}</span>)}</div>
  </div>
</article>
