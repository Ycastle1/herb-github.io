---
import { render, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getPosts, path, dateLabel, readingTime } from '../../lib/posts';
export async function getStaticPaths() {
  return (await getPosts()).map(post => ({ params: { id: post.id }, props: { post } }));
}
interface Props { post: CollectionEntry<'posts'>; }
const { post } = Astro.props;
const { Content, headings } = await render(post);
const toc = headings.filter(heading => heading.depth === 2);
---
<BaseLayout title={post.data.title} description={post.data.description} article date={post.data.date}>
  <div class="article-top"><a class="text-link" href={path()}>← 모든 기록</a></div>
  <header class="article-header">
    <div class="post-tags">{post.data.tags.map(tag => <span>#{tag}</span>)}</div>
    <h1>{post.data.title}</h1>
    <p>{post.data.description}</p>
    <div class="post-meta"><time datetime={post.data.date.toISOString()}>{dateLabel(post.data.date)}</time><span>·</span><span>{readingTime(post)}분 읽기</span></div>
  </header>
  <div class="article-grid">
    <article class="prose"><Content /></article>
    {toc.length > 0 && <aside class="toc"><nav aria-label="이 글의 목차"><p class="eyebrow">ON THIS PAGE</p><ol>{toc.map(heading => <li><a href={`#${heading.slug}`}>{heading.text}</a></li>)}</ol></nav></aside>}
  </div>
  <div class="article-bottom"><p>하나의 기록, 한 걸음의 성장.</p><a class="text-link" href={path()}>다른 기록 읽기 ↗</a></div>
</BaseLayout>
